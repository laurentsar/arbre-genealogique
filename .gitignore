.DS_Store

# Node / Capacitor
node_modules
www
*.log

# Config backend (URL + secret webhook HA) — build privé « famille » uniquement,
# jamais dans le dépôt public ni dans les Releases CI.
backend-config.js

# Python
__pycache__/
*.pyc

# Android signing (jamais committe)
android/app/signing.p12
*.p12
*.keystore
# Exception : clé de debug standard (pas un secret), committée pour que
# toutes les builds CI/local partagent la même signature (cf. build.gradle).
!android/app/debug.keystore
